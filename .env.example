# Configuration for The Lenny Growth Assistant

# Provider selection: "ollama" (local) or "cloud" (Anthropic Claude SDK)
PROVIDER_TYPE=ollama

# Local Ollama settings (no API key required)
# Note for Docker on Windows/Mac: use http://host.docker.internal:11434 to reach host Ollama
OLLAMA_BASE_URL=http://localhost:11434
# Supported local models: "qwen2.5:3b" (default), "gemma3:4b" (Google Gemma 3 4B)
# To install Gemma 3 4B: run `ollama pull gemma3:4b` in your terminal
OLLAMA_MODEL=qwen2.5:3b

# Cloud provider settings (Anthropic Claude - Required only when PROVIDER_TYPE=cloud)
ANTHROPIC_API_KEY=
CLOUD_MODEL=claude-3-5-sonnet-20241022

# Second Cloud provider settings (Google Gemini - Required only when PROVIDER_TYPE=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Database Connection (SQLite default for local dev; PostgreSQL for production/Docker)
DATABASE_URL=sqlite:///./lenny_growth_assistant.db
# PostgreSQL example: DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_assistant
